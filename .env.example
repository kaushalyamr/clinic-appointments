# Server port
PORT=3000

# SQLite file (created automatically; use ":memory:" for a throwaway run)
DB_PATH=./data/clinic.db

# IANA timezone the clinic operates in. All slot maths, "past slot" filtering and
# the 2-hour guard are done in this zone, on both server and browser.
CLINIC_TIMEZONE=Asia/Karachi

# Session lifetime in hours, and whether the session cookie needs HTTPS.
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Patients cannot cancel or reschedule inside this window (minutes).
RESCHEDULE_GUARD_MINUTES=120

# In-app reminder fires when an appointment starts within this window (minutes).
REMINDER_WINDOW_MINUTES=60

# Only used by `npm run seed` for the demo accounts. Not a real credential.
SEED_PASSWORD=clinic1234
